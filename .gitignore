# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is the template and IS meant to be committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/tooling metadata
.agents/
.claude/
.idea/
skills-lock.json

# architecture diagram tooling: Structurizr CLI is downloaded on demand by
# `npm run diagram` (scripts/render-architecture.mjs), not committed; its
# intermediate Mermaid export is regenerated every run
/.cache/
architecture/.export/
